{
    "name": "minimailer/laravel-minimailer",
    "description": "Laravel mail transport for MiniMailer — send with MAIL_MAILER=minimailer.",
    "keywords": [
        "minimailer",
        "laravel",
        "mail",
        "transport",
        "email",
        "mailer"
    ],
    "homepage": "https://minimailer.app",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "minimailer",
            "email": "hello@minimailer.app"
        }
    ],
    "support": {
        "issues": "https://github.com/minimailer/laravel-minimailer/issues",
        "source": "https://github.com/minimailer/laravel-minimailer",
        "security": "https://github.com/minimailer/laravel-minimailer/security/policy",
        "docs": "https://api.minimailer.app/openapi.yaml"
    },
    "require": {
        "php": "^8.2",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "minimailer/minimailer-php": "^0.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0 || ^5.0"
    },
    "repositories": {
        "minimailer-php": {
            "type": "vcs",
            "url": "https://github.com/minimailer/minimailer-php"
        }
    },
    "autoload": {
        "psr-4": {
            "MiniMailer\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiniMailer\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MiniMailer\\Laravel\\MinimailerServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "policy": {
            "malware": {
                "block": true,
                "block-scope": "all"
            },
            "advisories": {
                "block": true
            },
            "abandoned": {
                "audit": "report"
            }
        }
    },
    "scripts": {
        "lint": "pint --test",
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
